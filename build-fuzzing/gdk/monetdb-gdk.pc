prefix=/usr/local
libdir=/usr/local/lib
includedir=/usr/local/include

Name: monetdb-gdk
Description: MonetDB GDK library
URL: https://www.monetdb.org/
Version: 11.56.0
Requires.private: monetdb-stream = 11.56.0

Libs: -L${libdir} -lbat-11.56.0
Libs.private: -lm  -ldl
Cflags: -I${includedir}/monetdb
